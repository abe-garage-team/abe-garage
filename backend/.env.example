NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=abe_garage
DB_CONNECTION_LIMIT=10
# Server-only secret mixed into session cookie signatures and rate-limit keys.
# Generate at least 32 random characters; rotating it logs every employee out.
AUTH_TOKEN_PEPPER=
# Session cookie. In production the name is prefixed with __Host- automatically (requires HTTPS).
SESSION_COOKIE_NAME=abe_session
# Idle lifetime; a request within SESSION_UPDATE_AGE_HOURS of expiry extends it by SESSION_TTL_HOURS again.
SESSION_TTL_HOURS=12
SESSION_UPDATE_AGE_HOURS=2
# Hard ceiling measured from login regardless of activity.
SESSION_ABSOLUTE_HOURS=168
# Oldest sessions are revoked when an employee exceeds this many live sessions.
SESSION_MAX_PER_EMPLOYEE=10
# Set to the number of reverse proxies in front of the API (0 for direct exposure) so rate limits see real client IPs.
TRUST_PROXY=0
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
GARAGE_TIMEZONE=Africa/Addis_Ababa
CURRENCY_CODE=ETB
# MAIL_ADAPTER=smtp sends real email; MAIL_ADAPTER=fake records messages in memory (development and tests only).
MAIL_ADAPTER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
INSTALL_ENABLED=false
INSTALL_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD=
GARAGE_NAME=
GARAGE_ADDRESS=
GARAGE_PHONE=
GARAGE_EMAIL=
